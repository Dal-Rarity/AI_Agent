# 大模型 API Key（阿里云百炼兼容接口，qwen.py 中 ChatOpenAI 默认读取）
OPENAI_API_KEY=your-qwen-api-key-here

# 阿里云百炼知识库（仅 RAG 工具使用，不用知识库可留空）
ALIBABA_CLOUD_ACCESS_KEY_ID=your-alibaba-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-alibaba-access-key-secret

AMAP_KEY=your-amap-key-here
GITHUB_TOKEN=your-github-token-here

# MySQL 连接（infra_expert 使用；密码必填）
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
